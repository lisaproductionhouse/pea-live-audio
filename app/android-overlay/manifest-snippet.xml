<!--
  Thêm vào  app/src-tauri/gen/android/app/src/main/AndroidManifest.xml  (sau khi chạy `cargo tauri android init`).
  Chỉ cần dán thêm các dòng dưới đây; đừng xoá những gì Tauri đã sinh ra.
-->

<!-- (1) Trong thẻ <manifest>, cạnh <uses-permission android:name="android.permission.INTERNET" /> -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
<uses-permission android:name="android.permission.WAKE_LOCK" />
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- (2) Trong thẻ <activity android:name=".MainActivity" ...>:
       - đảm bảo có  android:launchMode="singleTask"  (để link chia sẻ vào qua onNewIntent)
       - thêm thêm một <intent-filter> nữa, ngoài cái MAIN/LAUNCHER có sẵn: -->
<intent-filter>
    <action android:name="android.intent.action.SEND" />
    <category android:name="android.intent.category.DEFAULT" />
    <data android:mimeType="text/plain" />
</intent-filter>

<!-- (3) Trong thẻ <application>, ngang hàng với <activity>: -->
<service
    android:name=".PlaybackService"
    android:exported="false"
    android:foregroundServiceType="mediaPlayback" />
